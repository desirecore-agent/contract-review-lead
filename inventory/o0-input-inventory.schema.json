        },
        "digest_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "object_id",
            "version_label",
            "canonical_path",
            "content_digest"
          ],
          "description": "Identity binding retained with the frozen file row.",
          "properties": {
