              "type": "string",
              "minLength": 1,
              "description": "Owning case identifier."
            },
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Bound object identifier."
            },
            "version_label": {
              "type": "string",
              "minLength": 1,
              "description": "Bound version label."
            },
            "canonical_path": {
              "type": "string",
              "minLength": 1,
              "description": "Bound normalized absolute path."
            },
            "content_digest": {
              "type": [
                "string",
                "null"
              ],
              "description": "Bound FileDigest value or null if unavailable."
            }
          }
        },
        "classification_basis": {
          "$ref": "#/definitions/classificationBasis"
        },
        "reference_id": {
          "type": "string",
          "minLength": 1,
          "description": "Reference-only resume-state identifier."
        },
        "use": {
          "const": "reference_only_not_execution_identity",
          "description": "Requires continue and action resume identities to come from platform-controlled Delegate or runtime records, never this material."
        }
      }
    },
    "unclassifiedMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "canonical_path",
        "content_digest",
        "size_bytes",
        "reason",
        "use"
      ],
      "description": "File-backed material whose role cannot be safely classified. It remains outside every consumable source set.",
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1,
          "description": "Lead-assigned unclassified-material identifier."
        },
        "canonical_path": {
          "type": "string",
          "minLength": 1,
          "description": "Normalized absolute path retained for clarification and audit."
        },
        "content_digest": {
          "type": [
            "string",
            "null"
          ],
          "description": "FileDigest SHA-256 or null when unavailable."
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Observed size or null when unavailable."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why classification requires user clarification; not a legal or identity conclusion."
